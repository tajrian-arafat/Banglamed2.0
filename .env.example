# BanglaMed environment (copy to .env). NEVER commit the real .env.
APP_NAME=BanglaMed
ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Absolute path recommended; relative paths resolve against the process CWD.
DATABASE_URL=sqlite:////workspace/banglamed2.0/data/banglamed.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OCR: null (typed fallback) | tesseract | gemini
OCR_PROVIDER=null
GEMINI_API_KEY=
# Maps: overpass (free, no key) | google
MAP_PROVIDER=overpass
# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
MAX_UPLOAD_MB=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=120
